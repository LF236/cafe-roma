      </div>
    </div>
    <div class="relative w-full max-w-125 justify-self-center p-3.5">
      <div class="absolute inset-0 translate-x-3.5 translate-y-3.5 border border-amber-brand"></div>
      <div class="relative aspect-4/5 overflow-hidden bg-espresso shadow-[0_20px_40px_rgba(30,15,8,.25)]">
        <img src="/images/roma.webp" alt="Salón de Café Roma" class="size-full scale-[1.12] object-cover object-[22%_70%]" />
      </div>
    </div>
  </div>
