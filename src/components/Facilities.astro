---
const spaces = [
  { label: "Terraza", d: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" },
  { label: "Salón privado", d: "M13 4h3a2 2 0 0 1 2 2v14M2 20h20M13 20V3.5a.5.5 0 0 0-.6-.5L6 4.5V20M10 12v.01" },
  { label: "Estacionamiento propio", d: "M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM9 17V7h4a3 3 0 0 1 0 6H9" },
];
---

<section id="instalaciones" class="section-pad bg-bga">
  <div class="mx-auto grid max-w-285 grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-[clamp(40px,6vw,88px)]">
    <figure class="relative m-0 aspect-4/3 overflow-hidden bg-espresso">
      <img src="/images/roma.webp" alt="Muro de barricas en el salón de Café Roma" loading="lazy" class="size-full scale-[1.12] object-cover object-[78%_45%]" />
      <figcaption class="absolute bottom-0 left-0 bg-espresso/85 px-5 py-3 font-serif text-xl italic text-sand">El muro de barricas</figcaption>
    </figure>
    <div class="flex flex-col gap-8">
      <h2 class="h-section">Espacios para cada ocasión</h2>
      <ul class="m-0 flex list-none flex-col border-t border-line p-0">
        {spaces.map((s) => (
          <li class="flex items-center gap-4 border-b border-line py-5 font-serif text-[clamp(21px,2.4vw,26px)] text-ink">
            <svg class="size-6 shrink-0 text-amber-t" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d={s.d} /></svg>
            {s.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
