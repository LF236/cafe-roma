---
const badges = [
  { label: "Terraza", d: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" },
  { label: "Salón privado", d: "M13 4h3a2 2 0 0 1 2 2v14M2 20h20M13 20V3.5a.5.5 0 0 0-.6-.5L6 4.5V20M10 12v.01" },
  { label: "Estacionamiento propio", d: "M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM9 17V7h4a3 3 0 0 1 0 6H9" },
];
const slots = ["Foto: terraza", "Foto: salón privado", "Foto: fachada", "Foto: platillo"];
---

<section id="instalaciones" class="section-pad bg-bga">
  <div class="mx-auto flex max-w-285 flex-col gap-11">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-140 flex-col gap-3.5">
        <div class="eyebrow text-amber-t">Instalaciones</div>
        <h2 class="m-0 text-balance font-display text-[clamp(36px,5vw,54px)] font-medium leading-[1.08] text-ink">Espacios para cada ocasión</h2>
      </div>
      <div class="flex flex-wrap gap-2.5">
        {badges.map((b) => (
          <div class="flex items-center gap-2.5 border border-amber-t px-4 py-2.5 text-[15px] text-ink">
            <svg class="size-5 text-amber-t" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d={b.d} /></svg>
            {b.label}
          </div>
        ))}
      </div>
    </div>

    <div class="grid auto-rows-65 grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-3">
      <div class="relative row-span-2 overflow-hidden bg-espresso">
        <img src="/images/roma.webp" alt="Muro de barricas" class="size-full scale-[1.12] object-cover object-[78%_45%]" />
        <div class="absolute bottom-0 left-0 bg-espresso/80 px-4.5 py-3.5 font-serif text-xl italic text-sand">El muro de barricas</div>
      </div>
      {slots.map((s) => (
        <div class="flex items-center justify-center border border-line bg-card/60 text-sm text-mute">{s}</div>
      ))}
    </div>
  </div>
</section>
