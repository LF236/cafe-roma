---
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_LINKS, SITE } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-line bg-hdr backdrop-blur-sm">
  <div class="mx-auto flex max-w-300 items-center justify-between gap-4 px-5 py-3">
    <a href="#inicio" class="flex flex-col items-start bg-wine px-3.5 pb-2 pt-1.5 leading-none text-cream hover:text-cream">
      <span class="font-display text-[22px] font-medium italic tracking-[-0.01em]">{SITE.name}</span>
      <span class="mt-1 whitespace-nowrap text-[9px] font-semibold uppercase tracking-[0.28em] text-sand">{SITE.location}</span>
    </a>

    <nav class="hidden items-center gap-7 text-xs font-semibold uppercase tracking-[0.14em] min-[1080px]:flex">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="link-line text-hdr-ink hover:text-hov">{l.label}</a>
      ))}
      <a href="#contacto" data-pick-cta="rest" class="whitespace-nowrap border border-gold-brand bg-wine px-4.5 py-2.75 text-cream transition-colors hover:bg-wine-hover hover:text-cream active:scale-[0.985]">Reservar mesa</a>
      <ThemeToggle />
    </nav>

    <div class="flex gap-2 min-[1080px]:hidden">
      <ThemeToggle />
      <button data-menu-toggle aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu" class="flex size-11 cursor-pointer items-center justify-center border border-line bg-transparent text-hdr-ink">
        <svg class="size-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col px-5 pb-5 pt-2 font-serif text-2xl min-[1080px]:hidden! [&:not(.hidden)]:flex">
    {NAV_LINKS.map((l, i) => (
      <a href={l.href} class:list={["py-2.5 text-hdr-ink", i < NAV_LINKS.length - 1 && "border-b border-line"]}>{l.mobileLabel}</a>
    ))}
  </nav>
</header>
