---
const items = [
  {
    title: "Fusión europea",
    text: "Chistorra, chorizo español y pastas de inspiración italiana.",
    d: ["M8 22h8M12 15v7M7 2h10l-.6 6.5A4.4 4.4 0 0 1 12 15a4.4 4.4 0 0 1-4.4-6.5z", "M7.4 7h9.2"],
  },
  {
    title: "Cocina mexicana",
    text: "Cortes de carne, pescado y platillos locales de la región.",
    d: ["M3 2v7a3 3 0 0 0 3 3v10M9 2v7a3 3 0 0 1-3 3M6 2v5", "M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3zm0 0v7"],
  },
  {
    title: "Buffet dominical",
    text: "Todos los domingos. Niños menores de 5 años sin costo.",
    d: ["M16 2v4M8 2v4M3 10h18", "M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2z"],
  },
];
---

<section id="restaurante" class="section-pad bg-bgb text-ink">
  <div class="mx-auto flex max-w-285 flex-col gap-14">
    <div class="flex flex-col items-center gap-4 text-center">
      <div class="eyebrow text-gold">Restaurante</div>
      <h2 class="m-0 text-balance font-display text-[clamp(36px,5vw,56px)] font-medium leading-[1.08] text-gold">Dos cocinas, una misma mesa</h2>
      <p class="m-0 max-w-140 font-serif text-[22px] italic leading-[1.45] text-ink2">Sabores del Mediterráneo y del altiplano veracruzano, servidos sin prisa.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] border-t border-line">
      {items.map((it) => (
        <div class="flex flex-col gap-4 border-b border-line px-7 py-10 not-first:border-l">
          <svg class="size-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            {it.d.map((p) => <path d={p} />)}
          </svg>
          <h3 class="m-0 font-display text-[28px] font-medium">{it.title}</h3>
          <p class="m-0 text-base leading-[1.7] text-ink2">{it.text}</p>
        </div>
      ))}
    </div>
    <div class="flex justify-center">
      <a href="#contacto" class="btn border-gold bg-transparent text-gold hover:bg-gold hover:text-bgb">Ver menú completo</a>
    </div>
  </div>
</section>
<div class="gold-rule"></div>
