---
const items = [
  {
    title: "Fusión europea",
    text: "Chistorra, chorizo español y pastas de inspiración italiana.",
  },
  {
    title: "Cocina mexicana",
    text: "Cortes de carne, pescado y platillos locales de la región.",
  },
  {
    title: "Buffet dominical",
    text: "Todos los domingos. Niños menores de 5 años sin costo.",
  },
];
---

<section id="restaurante" class="section-pad bg-bgb text-ink">
  <div class="mx-auto flex max-w-285 flex-col gap-14">
    <div class="flex flex-col items-center gap-5 text-center">
      <h2 class="h-section">Dos cocinas, una misma mesa</h2>
      <p class="lead max-w-140 italic text-ink2">Sabores del Mediterráneo y del altiplano veracruzano, servidos sin prisa.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] border-t border-line">
      {items.map((it) => (
        <div class="flex flex-col gap-3 border-b border-line px-7 py-10 not-first:border-l max-[619px]:not-first:border-l-0 max-[619px]:px-0">
          <h3 class="m-0 font-display text-[clamp(24px,3vw,28px)] font-medium leading-[1.15] tracking-[-0.01em] text-gold">{it.title}</h3>
          <p class="m-0 text-pretty text-base leading-[1.7] text-ink2">{it.text}</p>
        </div>
      ))}
    </div>
    <div class="flex justify-center">
      <a href="#contacto" class="btn border-gold bg-transparent text-gold hover:bg-gold hover:text-bgb">Ver menú completo</a>
    </div>
  </div>
</section>
<div class="gold-rule"></div>
