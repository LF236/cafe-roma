---
import { SITE } from "../config/site";

const field =
  "min-h-12.5 border border-field bg-transparent px-3.5 text-base normal-case tracking-normal text-ink outline-hidden focus:border-gold";
const label = "flex flex-col gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-ink2";
---

<section id="contacto" class="section-pad bg-bgb text-ink">
  <div class="mx-auto flex max-w-285 flex-col gap-12">
    <div class="flex flex-col gap-3.5">
      <h2 class="h-section">Reserve su mesa</h2>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-8">
      <div class="border border-line bg-card p-[clamp(24px,4vw,40px)]">
        <form id="reservation-form" data-type="rest" class="flex flex-col gap-5">
          <div class="grid grid-cols-2 border border-gold">
            <button type="button" data-pick="rest" data-active="true" class="min-h-12 cursor-pointer border-0 bg-transparent text-[13px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors data-[active=true]:bg-wine data-[active=true]:text-cream dark:data-[active=true]:bg-gold-brand dark:data-[active=true]:text-espresso">Restaurante</button>
            <button type="button" data-pick="hotel" data-active="false" class="min-h-12 cursor-pointer border-0 bg-transparent text-[13px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors data-[active=true]:bg-wine data-[active=true]:text-cream dark:data-[active=true]:bg-gold-brand dark:data-[active=true]:text-espresso">Hotel</button>
          </div>
          <label class={label}>Nombre
            <input name="nombre" autocomplete="name" required placeholder="Su nombre" class={field} />
          </label>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-3.5">
            <label class={label}><span data-date-label>Fecha</span>
              <input name="fecha" type="date" required class={field} />
            </label>
            <label class={label}><span data-count-label>Personas</span>
              <input name="personas" type="number" inputmode="numeric" min="1" value="2" class={field} />
            </label>
          </div>
          <button type="submit" data-submit class="btn-wine min-h-13.5 cursor-pointer">Reservar mesa</button>
        </form>

        <div id="reservation-done" class="hidden min-h-80 flex-col justify-center gap-3.5 [&:not(.hidden)]:flex">
          <div class="font-script text-[clamp(44px,6vw,56px)] leading-none text-gold">Grazie mille</div>
          <p class="m-0 text-[17px] leading-[1.6] text-ink2">Recibimos su solicitud. Le confirmaremos por WhatsApp en breve.</p>
          <button id="reservation-reset" class="mt-2 min-h-11 cursor-pointer self-start border border-field bg-transparent px-5 text-sm text-ink2 transition-colors hover:border-gold hover:text-ink">Nueva reservación</button>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-6">
          <div class="flex flex-col gap-1.5">
            <span class="label-caps">Teléfono / WhatsApp</span>
            <a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="link-line font-serif text-2xl tabular-nums text-ink hover:text-gold">{SITE.phone}</a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="label-caps">Horario</span>
            <span class="font-serif text-[clamp(19px,2.2vw,22px)] leading-[1.25]">Lun – Dom<br />8:00 – 22:00</span>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="label-caps">Pago</span>
            <span class="font-serif text-[clamp(19px,2.2vw,22px)] leading-[1.25]">Tarjeta y efectivo</span>
          </div>
        </div>
        <div class="min-h-75 flex-1 overflow-hidden border border-line">
          <iframe
            title="Mapa Café Roma"
            src={`https://www.google.com/maps?q=${SITE.mapQuery}&output=embed`}
            class="size-full min-h-75 border-0 contrast-[.95] sepia-[.35]"
            loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
