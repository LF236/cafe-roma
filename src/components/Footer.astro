---
import { NAV_LINKS, SITE } from "../config/site";
---

<footer class="border-t border-line bg-foot px-5 pb-24 pt-14 text-ink">
  <div class="mx-auto flex max-w-285 flex-wrap items-start justify-between gap-8">
    <div class="flex flex-col gap-3">
      <span class="self-start bg-wine px-3.5 py-1.5 font-display text-[22px] italic text-cream">{SITE.name}</span>
      <span class="font-serif text-[19px] italic">Perote, Veracruz — Centro Histórico</span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
      {NAV_LINKS.map((l) => <a href={l.href} class="text-gold hover:text-hov">{l.label}</a>)}
    </nav>
  </div>
  <div class="mx-auto mt-10 max-w-285 border-t border-line pt-5 text-[13px] text-mute">
    © 2026 {SITE.name} · Perote, Veracruz
  </div>
</footer>

<a
  href="#contacto"
  data-pick-cta="rest"
  class="btn-wine fixed inset-x-3 bottom-3 z-60 shadow-[0_8px_24px_rgba(0,0,0,.35)] hover:text-cream min-[1080px]:hidden text-cream"
>Reservar mesa</a>
